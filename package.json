{
  "name": "named-slots",
  "version": "0.4.2",
  "type": "module",
  "files": [
    "dist"
  ],
  "keywords": [
    "slots",
    "named",
    "preact",
    "react",
    "solid"
  ],
  "main": "./dist/Slot.js",
  "module": "./dist/Slot.js",
  "exports": {
    ".": {
      "types": "./dist/Slot.d.ts",
      "default": "./dist/Slot.js"
    },
    "./solid": {
      "types": "./dist/solid/Slot.d.ts",
      "default": "./dist/solid/Slot.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check:builds": "bash ./scripts/check-builds.sh",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maybebot/named-slots"
  },
  "author": "Ian Bobinac",
  "license": "MIT",
  "description": "Named slots for preact, react and solid",
  "peerDependencies": {
    "preact": ">=10",
    "react": ">=17",
    "solid-js": ">=1"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "happy-dom": "^20.9.0",
    "preact": "^10.29.1",
    "prettier": "3.8.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "solid-js": "^1.9.12",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.5"
  }
}
