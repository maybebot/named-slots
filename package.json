{
  "name": "named-slots",
  "version": "0.4.3",
  "description": "Named slots for preact, react and solid",
  "keywords": [
    "named",
    "preact",
    "react",
    "slots",
    "solid"
  ],
  "license": "MIT",
  "author": "Ian Bobinac",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maybebot/named-slots.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/Slot.js",
  "module": "./dist/Slot.js",
  "exports": {
    ".": {
      "types": "./dist/Slot.d.ts",
      "default": "./dist/Slot.js"
    },
    "./solid": {
      "types": "./dist/solid/Slot.d.ts",
      "default": "./dist/solid/Slot.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt",
    "check:builds": "bash ./scripts/check-builds.sh",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "happy-dom": "^20.9.0",
    "oxfmt": "^0.51.0",
    "preact": "^10.29.2",
    "prettier": "3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "solid-js": "^1.9.13",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "preact": ">=10",
    "react": ">=17",
    "solid-js": ">=1"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.3.0"
}
