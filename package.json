{
  "name": "named-slots",
  "version": "0.4.2",
  "type": "module",
  "files": [
    "dist"
  ],
  "keywords": [
    "slots",
    "named",
    "preact",
    "react",
    "solid"
  ],
  "main": "./dist/Slot.js",
  "module": "./dist/Slot.js",
  "exports": {
    ".": {
      "types": "./dist/Slot.d.ts",
      "default": "./dist/Slot.js"
    },
    "./solid": {
      "types": "./dist/solid/Slot.d.ts",
      "default": "./dist/solid/Slot.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check:builds": "bash ./scripts/check-builds.sh"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maybebot/named-slots"
  },
  "author": "Ian Bobinac",
  "license": "MIT",
  "description": "Named slots for preact, react and solid",
  "peerDependencies": {
    "preact": ">=10",
    "react": ">=17",
    "solid-js": ">=1"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "prettier": "3.8.3",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3"
  }
}
